    "@nivo/scatterplot": "0.99.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fumadocs-core": "16.14.3",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.3",
    "katex": "0.18.4",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.12",
    "next": "16.3.0",
    "react": "19.2.8",
