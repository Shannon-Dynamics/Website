{
  "name": "shannon-website",
  "version": "0.0.0",
  "private": true,
  "description": "The Shannon Dynamics marketing site. Hand-written HTML; the only build step is Tailwind.",
  "scripts": {
    "build:css": "tailwindcss -i styles/tailwind.css -o dist/assets/tailwind.css --minify",
    "build": "bash scripts/build-site.sh",
    "watch:css": "tailwindcss -i styles/tailwind.css -o dist/assets/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
